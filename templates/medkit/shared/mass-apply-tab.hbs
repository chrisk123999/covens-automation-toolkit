<section class="tab body standard-form{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}"
    data-tab="{{tab.id}}">
    <fieldset data-section="mass-apply">
        <legend>{{localize "CAT.MEDKIT.MassApply.Label"}}</legend>
        {{#if automationCounts}}
            <div class="counts">
                {{#each automationCounts}}
                    <div class="count" data-medkit-status="{{status}}" {{#if names}} data-tooltip="{{names}}" {{/if}}>
                        <span class="value">{{count}}</span>
                        <span class="label">{{localize label}}</span>
                    </div>
                {{/each}}
            </div>
        {{/if}}
        <button type="button" data-action="massApply" data-tooltip="{{localize 'CAT.MEDKIT.MassApply.Tooltip'}}">
            <i class="fa-solid fa-download"></i>
            {{localize "CAT.MEDKIT.MassApply.Button"}}
        </button>
        {{#if auraField}}
            {{formGroup auraField name="flags.cat.disableAuras" value=disableAuras hint=(localize "CAT.MEDKIT.Scene.DisableAuras.Hint") rootId=@root.rootId}}
        {{/if}}
        {{#if dataCheck}}
            <div class="form-group">
                <label>{{localize "CAT.MEDKIT.DataIssues.Name"}}</label>
                <div class="form-fields" {{#unless hasDataIssues}}data-tooltip="{{localize 'CAT.MEDKIT.DataIssues.None'}}"{{/unless}}>
                    <button type="button" data-action="checkDataIssues" {{#unless hasDataIssues}}disabled{{/unless}}>
                        <i class="fa-solid fa-file-circle-exclamation"></i>
                        {{localize "CAT.MEDKIT.DataIssues.Button"}}
                    </button>
                </div>
                <p class="hint">{{localize "CAT.MEDKIT.DataIssues.Hint"}}</p>
            </div>
        {{/if}}
    </fieldset>
</section>
