{{#if field}}
    {{formGroup field name=name value=value hint=hint rootId=@root.rootId}}
{{else if isCombobox}}
    <div class="form-group">
        <label for="cat-medkit-opt-{{key}}">{{label}}</label>
        <div class="form-fields">
            <cat-combobox input-id="cat-medkit-opt-{{key}}" name="{{name}}" value="{{value}}">
                {{#if allowBlank}}
                    <option value=""></option>
                {{/if}}
                {{#each choices}}
                    <option value="{{value}}" data-image="{{image}}" {{#if invert}} data-invert="true" {{/if}}
                        data-tag="{{tag}}">
                        {{label}}
                    </option>
                {{/each}}
            </cat-combobox>
            {{#if compendiumPicker}}
                <button type="button" data-action="openCompendiumActor" data-flag-name="{{name}}"
                    data-summon-max="{{compendiumMax}}" data-tooltip="{{localize 'CAT.MEDKIT.Summons.CompendiumPick'}}">
                    <i class="fa-solid fa-book-open"></i>
                </button>
            {{/if}}
            {{#if compendiumItemPicker}}
                <button type="button" data-action="openCompendiumItem" data-flag-name="{{name}}"
                    data-tooltip="{{localize 'CAT.MEDKIT.Summons.ItemCompendiumPick'}}">
                    <i class="fa-solid fa-book-open"></i>
                </button>
            {{/if}}
        </div>
        {{#if hint}}
            <p class="hint">{{hint}}</p>
        {{/if}}
    </div>
{{else if isMultiCombobox}}
    <div class="form-group">
        <label for="cat-medkit-opt-{{key}}">{{label}}</label>
        <div class="form-fields">
            <cat-multi-combobox input-id="cat-medkit-opt-{{key}}" name="{{name}}">
                {{#each choices}}
                    <option value="{{value}}" data-image="{{image}}" {{#if invert}} data-invert="true" {{/if}}
                        data-tag="{{tag}}" {{#if selected}} selected{{/if}}>{{label}}</option>
                {{/each}}
            </cat-multi-combobox>
        </div>
        {{#if hint}}
            <p class="hint">{{hint}}</p>
        {{/if}}
    </div>
{{else if isSequencerFile}}
    <div class="form-group">
        <label for="cat-medkit-opt-{{key}}">{{label}}</label>
        <div class="form-fields">
            <file-picker input-id="cat-medkit-opt-{{key}}" name="{{name}}" type="{{fileType}}"
                value="{{value}}"></file-picker>
            <button type="button" data-action="openSequencerDb"
                data-tooltip="{{localize 'CAT.MEDKIT.Sequencer.Browse'}}">
                <i class="fa-solid fa-photo-film"></i>
            </button>
        </div>
        {{#if hint}}
            <p class="hint">{{hint}}</p>
        {{/if}}
    </div>
{{else if isAnimationSelect}}
    <div class="form-group">
        <label for="cat-medkit-opt-{{key}}">{{label}}</label>
        <div class="form-fields">
            <cat-combobox data-animation-select input-id="cat-medkit-opt-{{key}}" name="{{name}}" value="{{value}}">
                <option value=""></option>
                {{#each choices}}
                    {{#if options}}
                        <optgroup label="{{label}}">
                            {{#each options}}
                                <option value="{{value}}" data-image="{{image}}">{{label}}</option>
                            {{/each}}
                        </optgroup>
                    {{else}}
                        <option value="{{value}}" data-image="{{image}}">{{label}}</option>
                    {{/if}}
                {{/each}}
            </cat-combobox>
        </div>
        {{#if hint}}
            <p class="hint">{{hint}}</p>
        {{/if}}
        {{#each moduleAnimations}}
            <p class="notice notification warning">{{localize "CAT.Troubleshooter.Report.ModuleAnimation" module=this}}</p>
        {{/each}}
    </div>
    {{#if (and animationLabel (or animationOptions.length animationCredits.length))}}
        <div class="suboptions" data-section="animation-suboptions">
            <span class="subgroup">{{animationLabel}}</span>
            {{#each animationOptions}}
                {{> "modules/cat/templates/medkit/shared/option-field.hbs" this}}
            {{/each}}
            {{#if animationCredits.length}}
                <p class="hint">{{localize "CAT.MEDKIT.Animation.Credits"}}{{#each animationCredits}}
                        {{name}}{{#if discord}} <a href="{{discord}}" target="_blank" rel="noopener"
                                data-tooltip="{{localize 'CAT.MEDKIT.Animation.Discord'}}"><i
                                    class="fa-brands fa-discord"></i></a>{{/if}}{{#if patreon}} <a href="{{patreon}}"
                                target="_blank" rel="noopener"
                                data-tooltip="{{localize 'CAT.MEDKIT.Animation.Patreon'}}"><i
                                    class="fa-brands fa-patreon"></i></a>{{/if}}{{/each}}</p>
            {{/if}}
        </div>
    {{/if}}
{{else if isSummonSelect}}
    <div class="summons" data-flag-path="{{configPath}}" data-max="{{max}}">
        {{#if hint}}
            <p class="hint">{{hint}}</p>
        {{/if}}
        {{#each summonEntries}}
            <fieldset data-section="summon-entry">
                <legend>
                    <span>{{legend}}</span>
                    <button type="button" data-action="removeSummonEntry" data-index="{{index}}"
                        data-tooltip="{{localize 'COMMON.Delete'}}">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </legend>
                {{#each fields}}
                    {{> "modules/cat/templates/medkit/shared/option-field.hbs" this}}
                {{/each}}
                <div class="summon-items" data-flag-path="{{items.base}}">
                    {{#each items.entries}}
                        <fieldset data-section="summon-item">
                            <legend>
                                <span>{{legend}}</span>
                                <button type="button" data-action="removeSummonItem" data-index="{{index}}"
                                    data-tooltip="{{localize 'COMMON.Delete'}}">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </legend>
                            {{#each fields}}
                                {{> "modules/cat/templates/medkit/shared/option-field.hbs" this}}
                            {{/each}}
                        </fieldset>
                    {{/each}}
                    <button type="button" data-action="addSummonItem">
                        <i class="fa-solid fa-plus"></i> {{localize "CAT.MEDKIT.Summons.AddItem"}}
                    </button>
                </div>
            </fieldset>
        {{/each}}
        {{#if canAdd}}
            <button type="button" data-action="addSummonEntry">
                <i class="fa-solid fa-plus"></i> {{localize "CAT.MEDKIT.Summons.Add"}}
            </button>
        {{/if}}
    </div>
{{else if isList}}
    <div class="form-group documents" data-flag-path="{{configPath}}" data-validate="{{validate}}">
        <label for="cat-medkit-opt-{{key}}">{{label}}</label>
        <div class="form-fields">
            <input id="cat-medkit-opt-{{key}}" type="text" placeholder="{{localize placeholder}}">
            <button type="button" data-action="addListEntry" data-tooltip="{{localize addTooltip}}">
                <i class="fa-solid fa-plus"></i>
            </button>
        </div>
        {{#if hint}}
            <p class="hint">{{hint}}</p>
        {{/if}}
    </div>
    {{#if entries.length}}
        <ul class="doc-list" data-flag-path="{{configPath}}">
            {{#each entries}}
                <li>
                    {{#if img}}<img src="{{img}}">{{/if}}
                    <span>{{label}}</span>
                    <button type="button" data-action="removeListEntry" data-value="{{value}}"
                        data-tooltip="{{localize 'COMMON.Delete'}}">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </li>
            {{/each}}
        </ul>
    {{/if}}
{{/if}}
