{{#each inputs}}
    {{#cat-wrapIf legend "fieldset"}}
    {{#if legend}}<legend>{{localize legend}}</legend>{{/if}}
    {{#if useHelper}}
        {{#each options}}
            {{formGroup field name=name value=value}}
        {{/each}}
    {{else if isButton}}
        <div class="cat-body-buttons {{#if displayAsRows}}cat-stacked{{/if}}">
            {{#each options}}
                <button type="submit" class="cat-body-button" data-action="confirm" id="{{id}}" name="{{name}}"{{#if tooltip}} data-tooltip="{{tooltip}}"{{/if}}{{#if reference}} data-reference-tooltip="{{reference}}"{{/if}}>
                    {{#if image}}<img class="button-image{{#if imageClass}} {{imageClass}}{{/if}}{{#if invertColor}} cat-svg-color-invert{{/if}}" src="{{image}}">{{/if}}
                    <span>{{localize label}}</span>
                </button>
            {{/each}}
        </div>  
    {{else if isCheckbox}}
        {{#if showCounter}}
            <div class="cat-budget-counter{{#if (gte currentNum totalMax)}} at-max{{/if}}">{{currentNum}}/{{totalMax}}</div>
        {{/if}}
        {{#each options}}
            <div class="{{#if subinputs}}cat-collapsible collapsed{{/if}}" data-collapsible-id="{{id}}">
                <div class="{{#if subinputs}}cat-summary{{/if}}">
                    <div class="form-group inline{{#if locked}} cat-locked{{/if}}">
                        {{#if ../hasSubinputs}}
                        <div class="cat-collapsible-icon-placeholder"{{#if subinputs}} data-action="toggleCollapsed"{{/if}}>
                            {{#if subinputs}}<i class="fas fa-chevron-down fa-fw cat-collapsible-icon"></i>{{/if}}
                        </div>
                        {{/if}}
                        
                        <label for="{{id}}">
                            {{#if image}}<img class="label-image{{#if invertColor}} cat-svg-color-invert{{/if}}" src="{{image}}" data-token-id="{{name}}">{{/if}}
                            <span class="cat-label-text">{{{localize label}}}</span>
                        </label>
                        <div class="form-fields">
                            {{#if select}}
                                <select name="sel-{{name}}" id="{{id}}s">{{selectOptions select.choices selected=select.value}}</select>
                            {{/if}}
                            <input type="checkbox" {{#if locked}}disabled{{else if (gte ../currentNum ../totalMax)}}{{#unless isChecked}}disabled{{/unless}}{{/if}} id="{{id}}" name="{{name}}" {{#if isChecked}}checked{{/if}}>
                        </div>
                        {{#if hint}}<p class="hint">{{hint}}</p>{{/if}}
                    </div>
                </div>
                {{#if subinputs}}
                <div class="cat-collapsible-content">
                    <div class="cat-collapsible-wrapper">
                        {{> (lookup @root 'inputTemplate') inputs=subinputs inputTemplate=@root.inputTemplate}}
                    </div>
                </div>
                {{/if}}
            </div>
        {{/each}}
    {{else if isRadio}}
        {{#each options}}
            <div class="{{#if subinputs}}cat-collapsible collapsed{{/if}}" data-collapsible-id="{{id}}">
                <div class="{{#if subinputs}}cat-summary{{/if}}">
                    <div class="form-group">
                        {{#if ../hasSubinputs}}
                        <div class="cat-collapsible-icon-placeholder" {{#if subinputs}}data-action="toggleCollapsed"{{/if}}>
                            {{#if subinputs}}<i class="fas fa-chevron-down fa-fw cat-collapsible-icon"></i>{{/if}}
                        </div>
                        {{/if}}
                        
                        <label for="{{id}}">
                            {{#if image}}<img class="label-image{{#if invertColor}} cat-svg-color-invert{{/if}}" src="{{image}}" data-token-id="{{name}}">{{/if}}
                            {{localize label}}
                        </label>
                        <div class="form-fields">
                            <input type="radio" id="{{id}}" name="{{../radioName}}" value="{{name}}" {{#if isChecked}}checked{{/if}}>
                        </div>
                    </div>
                </div>
                {{#if subinputs}}
                <div class="cat-collapsible-content">
                    <div class="cat-collapsible-wrapper">
                        {{> (lookup @root 'inputTemplate') inputs=subinputs inputTemplate=@root.inputTemplate}}
                    </div>
                </div>
                {{/if}}
            </div>
        {{/each}}
    {{else if isSelectAmount}}
        {{#if totalMax}}
            <div class="cat-budget-counter{{#if atMax}} at-max{{/if}}">{{currentSpent}}/{{totalMax}}</div>
        {{/if}}
        {{#each options}}
            <div class="{{#if subinputs}}cat-collapsible collapsed{{/if}}" data-collapsible-id="{{id}}">
                <div class="{{#if subinputs}}cat-summary{{/if}}">
                    <div class="form-group">
                        {{#if ../hasSubinputs}}
                        <div class="cat-collapsible-icon-placeholder"{{#if subinputs}} data-action="toggleCollapsed"{{/if}}>
                            {{#if subinputs}}<i class="fas fa-chevron-down fa-fw cat-collapsible-icon"></i>{{/if}}
                        </div>
                        {{/if}}
                        
                        <label for="{{id}}">
                            {{#if image}}<img class="label-image{{#if invertColor}} cat-svg-color-invert{{/if}}" src="{{image}}" data-token-id="{{name}}">{{/if}}
                            {{{localize label}}}
                        </label>
                        <div class="form-fields">
                            <select id="{{id}}" name="{{name}}">
                                {{#each options}}
                                    <option value="{{this}}" {{#if (gt this ../currentMaxAmount)}}disabled{{/if}} {{#if (eq this ../currentAmount)}}selected{{/if}}>{{this}}</option>
                                {{/each}}
                            </select>
                        </div>
                    </div>
                </div>
                {{#if subinputs}}
                <div class="cat-collapsible-content">
                    <div class="cat-collapsible-wrapper">
                        {{> (lookup @root 'inputTemplate') inputs=subinputs inputTemplate=@root.inputTemplate}}
                    </div>
                </div>
                {{/if}}
            </div>
        {{/each}}
    {{else if isDice}}
        {{#if showCounter}}
            <div class="cat-budget-counter">{{currentNum}}/{{totalMax}}</div>
        {{/if}}
        <div class="cat-dice-picker" data-total-max="{{totalMax}}">
            {{#each groups}}
                <div class="cat-dice-group">
                    <header class="cat-dice-group-header">
                        {{#if icon}}<img class="cat-dmg-icon" src="{{icon}}">{{/if}}
                        {{#if label}}<span class="cat-dice-type-label">{{label}}</span>{{/if}}
                        <strong class="cat-dice-subtotal">{{total}}</strong>
                    </header>
                    <ol class="dice-rolls">
                        {{#each dice}}
                            <li class="cat-die-cell">
                                <input type="checkbox" hidden id="d-{{name}}" name="{{name}}">
                                <label for="d-{{name}}" class="roll d{{faces}}{{#unless isStandard}} cat-die-generic{{/unless}}{{#if isMin}} min{{/if}}{{#if isMax}} max{{/if}}" data-tooltip="d{{faces}}">{{result}}</label>
                            </li>
                        {{/each}}
                    </ol>
                </div>
            {{/each}}
            {{#if grandTotal}}
                <div class="cat-dice-grand-total"><span>{{localize 'CAT.Dialog.Total'}}</span><strong>{{grandTotal}}</strong></div>
            {{/if}}
        </div>
    {{else if isCombobox}}
        {{#each options}}
            <div class="{{#if subinputs}}cat-collapsible collapsed{{/if}}" data-collapsible-id="{{id}}">
                <div class="{{#if subinputs}}cat-summary{{/if}}">
                    <div class="form-group{{#unless label}} cat-no-label{{/unless}}">
                        {{#if ../hasSubinputs}}
                        <div class="cat-collapsible-icon-placeholder"{{#if subinputs}} data-action="toggleCollapsed"{{/if}}>
                            {{#if subinputs}}<i class="fas fa-chevron-down fa-fw cat-collapsible-icon"></i>{{/if}}
                        </div>
                        {{/if}}
                        
                        {{#if label}}<label for="{{id}}">{{{localize label}}}</label>{{/if}}
                        <div class="form-fields">
                            <cat-combobox input-id="{{id}}" name="{{name}}" value="{{value}}"{{#if placeholder}} placeholder="{{placeholder}}"{{/if}}>
                                {{#each options}}
                                    <option value="{{value}}" data-image="{{image}}"{{#if tag}} data-tag="{{tag}}"{{/if}}>{{label}}</option>
                                {{/each}}
                            </cat-combobox>
                        </div>
                    </div>
                </div>
                {{#if subinputs}}
                <div class="cat-collapsible-content">
                    <div class="cat-collapsible-wrapper">
                        {{> (lookup @root 'inputTemplate') inputs=subinputs inputTemplate=@root.inputTemplate}}
                    </div>
                </div>
                {{/if}}
            </div>
        {{/each}}
    {{else if isComboboxMulti}}
        {{#each options}}
            <div class="{{#if subinputs}}cat-collapsible collapsed{{/if}}" data-collapsible-id="{{id}}">
                <div class="{{#if subinputs}}cat-summary{{/if}}">
                    <div class="form-group cat-multi-combobox-group{{#unless label}} cat-no-label{{/unless}}">
                        {{#if ../hasSubinputs}}
                        <div class="cat-collapsible-icon-placeholder" {{#if subinputs}}data-action="toggleCollapsed"{{/if}}>
                            {{#if subinputs}}<i class="fas fa-chevron-down fa-fw cat-collapsible-icon"></i>{{/if}}
                        </div>
                        {{/if}}
                        
                        {{#if label}}<label for="{{id}}">{{{localize label}}}</label>{{/if}}
                        <cat-multi-combobox input-id="{{id}}" name="{{name}}"{{#if amounts}} amounts{{/if}}{{#if maxTotal}} max-total="{{maxTotal}}"{{/if}}{{#if placeholder}} placeholder="{{placeholder}}"{{/if}}>
                            {{#each options}}
                                <option value="{{value}}" data-image="{{image}}" data-weight="{{weight}}"{{#if max}} data-max="{{max}}"{{/if}}{{#if tag}} data-tag="{{tag}}"{{/if}}>{{label}}</option>
                            {{/each}}
                        </cat-multi-combobox>
                    </div>
                </div>
                {{#if subinputs}}
                <div class="cat-collapsible-content">
                    <div class="cat-collapsible-wrapper">
                        {{> (lookup @root 'inputTemplate') inputs=subinputs inputTemplate=@root.inputTemplate}}
                    </div>
                </div>
                {{/if}}
            </div>
        {{/each}}
    {{/if}}
    {{/cat-wrapIf}}
{{/each}}
