<section class="tab body standard-form{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}"
    data-tab="{{tab.id}}">
    <fieldset data-section="mass-apply">
        <legend>{{localize "CAT.MEDKIT.MassApply.Label"}}</legend>
        {{#if automationCounts}}
            <div class="counts">
                {{#each automationCounts}}
                    <div class="count" data-medkit-status="{{status}}" {{#if names}} data-tooltip="{{names}}" {{/if}}>
                        <span class="value">{{count}}</span>
                        <span class="label">{{localize label}}</span>
                    </div>
                {{/each}}
            </div>
        {{/if}}
        <button type="button" data-action="massApply" data-tooltip="{{localize 'CAT.MEDKIT.MassApply.Tooltip'}}">
            <i class="fa-solid fa-download"></i>
            {{localize "CAT.MEDKIT.MassApply.Button"}}
        </button>
    </fieldset>
</section>
