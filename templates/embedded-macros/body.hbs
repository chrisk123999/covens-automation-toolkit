<div class="body">
    <div class="standard-form">
        {{#each inputs as |input key|}}
            {{#if input.singleCombobox}}
                <div class="form-group">
                    <label>{{input.label}}</label>
                    <div class="form-fields">
                        <cat-combobox name="{{key}}" value="{{input.value}}">
                            {{#each input.options}}
                                <option value="{{value}}" {{#if group}} data-group="{{group}}" {{/if}}{{#if selected}}
                                    selected{{/if}}>{{label}}</option>
                            {{/each}}
                        </cat-combobox>
                    </div>
                </div>
            {{else if input.combobox}}
                <div class="form-group">
                    <label>{{input.label}}</label>
                    <div class="form-fields">
                        <cat-multi-combobox name="{{key}}">
                            {{#each input.options}}
                                <option value="{{value}}" {{#if selected}} selected{{/if}}>{{label}}</option>
                            {{/each}}
                        </cat-multi-combobox>
                    </div>
                </div>
            {{else}}
                {{formGroup input.field value=input.value name=key}}
            {{/if}}
        {{/each}}
    </div>
</div>
