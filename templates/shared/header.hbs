<header>
    <i class="fa-solid fa-shield-cat" {{#if medkitStatus}} data-medkit-status="{{medkitStatus}}" {{/if}}
        aria-hidden="true"></i>
    <span class="title">{{localize title}}</span>
    {{#if isDirty}}
        <span class="dirty"
            data-tooltip="{{localize 'CAT.MEDKIT.Dirty.Tooltip'}}">{{localize "CAT.MEDKIT.Dirty.Label"}}</span>
    {{/if}}
    {{#if detachable}}
        <button type="button" data-action="toggleDetach" data-tooltip="{{localize detachLabel}}"
            aria-label="{{localize detachLabel}}">
            <i class="fa-solid {{detachIcon}}" aria-hidden="true"></i>
        </button>
    {{/if}}
    <button type="button" data-action="{{closeAction}}" data-tooltip="{{localize 'APPLICATION.ACTIONS.Close'}}"
        aria-label="{{localize 'APPLICATION.ACTIONS.Close'}}">
        <i class="fas fa-xmark" aria-hidden="true"></i>
    </button>
</header>
