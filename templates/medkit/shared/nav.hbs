<nav class="tabs" aria-roledescription="{{localize 'SHEETS.FormNavLabel'}}">
    {{#each tabs}}
        <a data-action="tab" data-group="{{group}}" data-tab="{{id}}" class="{{cssClass}}" {{#if indicatorLabel}}
            data-tooltip="{{indicatorLabel}}" {{/if}}>
            {{#if icon}}<i class="{{icon}}" {{#if indicator}} data-indicator="{{indicator}}" {{/if}}{{#if status}}
                    data-medkit-status="{{status}}" {{/if}}></i>{{/if}}
            <span>{{localize label}}</span>
        </a>
    {{/each}}
</nav>
