{{#*inline "priorityRow"}}
    <li class="row{{#if sources}}{{#if content}}{{#if massApply}} content-mass-apply{{/if}}{{/if}}{{/if}}"{{#if enabled}} draggable="true"{{/if}} data-source-id="{{id}}" data-kind="{{kind}}" data-content="{{content}}">
        <span class="pill">{{kindLabel}}</span>
        <span class="name">{{name}}
            {{#if origin}}<span class="origin">{{origin.source}}
            {{#if origin.folders}} • <span class="folders"><i class="fas fa-folder fa-fw"></i> {{origin.folders}}</span>{{/if}}</span>{{/if}}
            {{#if sources}}{{#if content}}<span class="mass-apply-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{localize 'CAT.Settings.AutomationSources.ContentMassApplyWarning'}}</span>{{/if}}{{/if}}
        </span>
        {{#if sources}}
            <label class="mass-apply-label" draggable="false"{{#unless enabled}} hidden{{/unless}}>
                <input type="checkbox" class="mass-apply" {{checked massApply}} aria-label="{{localize 'CAT.Settings.AutomationSources.MassApply'}}">
            </label>
        {{/if}}
        <input type="number" class="rank" value="{{priority}}" draggable="false"{{#unless enabled}} hidden{{/unless}} aria-label="{{localize 'CAT.Settings.AutomationSources.Rank'}}">
        {{#if enabled}}
            <button type="button" draggable="false" data-priority-action="disable"
                data-tooltip="{{localize 'CAT.Settings.AutomationSources.Disable'}}"
                aria-label="{{localize 'CAT.Settings.AutomationSources.Disable'}}">
                <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
        {{else}}
            <button type="button" draggable="false" data-priority-action="enable"
                data-tooltip="{{localize 'CAT.Settings.AutomationSources.Enable'}}"
                aria-label="{{localize 'CAT.Settings.AutomationSources.Enable'}}">
                <i class="fas fa-plus" aria-hidden="true"></i>
            </button>
        {{/if}}
    </li>
{{/inline}}
<div id="menu-app" class="body standard-form">
    {{#if tabbed}}
        <nav>
            {{#each inputs}}
                <a class="tab-link{{#if (eq name ../tab)}} active{{/if}}" data-tab="{{name}}">{{label}}</a>
            {{/each}}
        </nav>
    {{/if}}
    {{#each inputs}}
        {{#if ../tabbed}}
            <section class="tab-panel{{#if (eq name ../tab)}} active{{/if}}" data-tab-panel="{{name}}">
        {{/if}}
        {{#if useHelper}}
            {{#each options}}
                {{formGroup field name=name value=value rootId=@root.rootId}}
            {{/each}}
        {{else if isMultiCombobox}}
            <div class="form-group">
                <label for="{{@root.rootId}}-{{name}}">{{localize label}}</label>
                <div class="form-fields">
                    <cat-multi-combobox input-id="{{@root.rootId}}-{{name}}" name="{{name}}">
                        {{#each options}}
                            <option value="{{value}}" {{#if selected}} selected{{/if}}>{{label}}</option>
                        {{/each}}
                    </cat-multi-combobox>
                </div>
                {{#if hint}}
                    <p class="hint">{{localize hint}}</p>
                {{/if}}
            </div>
        {{else if isPriority}}
            <div class="priority" data-source-setting="{{name}}" data-pack-setting="{{packSetting}}">
                {{#unless ../tabbed}}{{#if label}}
                        <h3>{{label}}</h3>
                    {{/if}}{{/unless}}
                {{#if hint}}
                    <p class="hint">{{{hint}}}</p>
                {{/if}}
                {{#if sources}}
                    <button type="button" class="recommended" data-priority-action="recommend" data-tooltip="{{localize 'CAT.Settings.AutomationSources.RecommendedHint'}}">
                        <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> {{localize 'CAT.Settings.AutomationSources.Recommended'}}
                    </button>
                {{/if}}
                <div class="priority-header">
                    <span class="spacer"></span>
                    {{#if sources}}<span class="mass-apply-label" data-tooltip="{{localize 'CAT.Settings.AutomationSources.MassApplyHint'}}">{{localize 'CAT.Settings.AutomationSources.MassApply'}}</span>{{/if}}
                    <span class="rank" data-tooltip="{{localize 'CAT.Settings.AutomationSources.RankHint'}}">{{localize 'CAT.Settings.AutomationSources.Rank'}}</span>
                    <span class="action"></span>
                </div>
                <ul data-list="enabled">
                    {{#each enabledRows}}
                        {{> priorityRow sources=../sources enabled=true}}
                    {{/each}}
                </ul>
                <details>
                    <summary>{{localize "CAT.Settings.AutomationSources.Disabled"}} (<span
                            class="disabled-count">{{disabledRows.length}}</span>)</summary>
                    <ul data-list="disabled">
                        {{#each disabledRows}}
                            {{> priorityRow sources=../sources enabled=false}}
                        {{/each}}
                    </ul>
                </details>
            </div>
        {{/if}}
        {{#if ../tabbed}}</section>{{/if}}
    {{/each}}
</div>
