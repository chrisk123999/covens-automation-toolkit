<div class="cat-dialog-shell">
<header class="cat-dialog-header">
    <i class="fa-solid fa-shield-cat cat-dialog-icon" aria-hidden="true"></i>
    <span class="cat-dialog-title">{{localize title}}</span>
    <button type="button" class="cat-app-header-button cat-dialog-detach" data-action="toggleDetach" data-tooltip="{{#if detached}}{{localize 'APPLICATION.ACTIONS.Attach'}}{{else}}{{localize 'APPLICATION.ACTIONS.Detach'}}{{/if}}" aria-label="{{#if detached}}{{localize 'APPLICATION.ACTIONS.Attach'}}{{else}}{{localize 'APPLICATION.ACTIONS.Detach'}}{{/if}}">
        <i class="fas {{#if detached}}fa-arrow-down-to-square{{else}}fa-arrow-up-right-from-square{{/if}}" aria-hidden="true"></i>
    </button>
    <button type="button" class="cat-app-header-button" data-action="close" data-tooltip="{{localize 'Close'}}" aria-label="{{localize 'Close'}}">
        <i class="fas fa-xmark" aria-hidden="true"></i>
    </button>
</header>
<div id="dialog-app" class="cat-dialog-body standard-form scrollable">
    {{#if content}}<div class="cat-dialog-content{{#unless inputs}} cat-dialog-content-only{{/unless}}">{{{localize content}}}</div>{{/if}}
    {{> (lookup @root 'inputTemplate') inputs=inputs inputTemplate=inputTemplate}}
</div>
{{#if buttons.length}}
<footer class="cat-dialog-footer">
    {{#each buttons}}
        <button type="submit" data-action="confirm" name="{{name}}">{{localize label}}</button>
    {{/each}}
</footer>
{{/if}}
</div>
